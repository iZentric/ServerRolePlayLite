command /vamag2:
    permission: vamaa.perm
    trigger:
        # Deschide ușa (transformă blocurile în aer)
        execute console command "fill 465 69 -246 455 69 -246 air"
        # Deschide ușa (transformă blocurile în aer)
        execute console command "fill 465 68 -246 455 68 -246 air"
        # Deschide ușa (transformă blocurile în aer)
        execute console command "fill 465 70 -246 455 72 -246 air"
        send "vama sa deschis" to player

        # Așteaptă 10 de secunde
        wait 10 seconds
        
        # Închide ușa (transformă blocurile înapoi în blocuri de fier)
        execute console command "fill 465 69 -246 455 69 -246 red_concrete"
        # Închide ușa (transformă blocurile înapoi în blocuri de fier)
        execute console command "fill 465 68 -246 455 68 -246 minecraft:barrier"
        # Închide ușa (transformă blocurile înapoi în blocuri de fier)
        execute console command "fill 465 70 -246 455 72 -246 minecraft:barrier"
        send "vama sa inchis" to player